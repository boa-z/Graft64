{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graft64 runtime manifest",
  "type": "object",
  "required": ["schema_version", "stage", "platform", "dependencies", "artifacts", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "stage": { "enum": ["G1", "G2", "G3"] },
    "platform": {
      "type": "object",
      "required": ["os", "architecture"],
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "const": "aarch64" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ref", "commit", "archive_sha256"],
        "properties": {
          "name": { "type": "string" },
          "ref": { "type": "string" },
          "commit": { "pattern": "^[0-9a-f]{40}$" },
          "archive_sha256": { "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "log"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"] },
          "log": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
